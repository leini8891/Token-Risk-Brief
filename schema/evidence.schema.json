{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leini8891/Token-Risk-Brief/schema/evidence.schema.json",
  "title": "Token Risk Brief normalized evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset",
    "as_of",
    "sources",
    "areas"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_address",
        "chain",
        "identity_verified"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "contract_address": {
          "type": "string",
          "minLength": 1
        },
        "chain": {
          "type": "string",
          "minLength": 1
        },
        "identity_verified": {
          "const": true
        },
        "fixture": {
          "type": "boolean"
        }
      }
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "areas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_control",
        "sellability",
        "liquidity",
        "holder_concentration"
      ],
      "properties": {
        "contract_control": {
          "$ref": "#/$defs/area"
        },
        "sellability": {
          "$ref": "#/$defs/area"
        },
        "liquidity": {
          "$ref": "#/$defs/area"
        },
        "holder_concentration": {
          "$ref": "#/$defs/area"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/limitation"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "retrieved_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary",
        "severity",
        "verified",
        "source_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "pass",
            "warning",
            "critical"
          ]
        },
        "verified": {
          "type": "boolean"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "area": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "findings",
            "unknown_checks"
          ],
          "properties": {
            "status": {
              "const": "available"
            },
            "findings": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/finding"
              }
            },
            "unknown_checks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "unknown_checks"
          ],
          "properties": {
            "status": {
              "const": "not_available"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "unknown_checks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "summary"
      ],
      "properties": {
        "type": {
          "enum": [
            "conflict",
            "stale",
            "single_source_dependency",
            "attribution_gap",
            "other"
          ]
        },
        "area": {
          "enum": [
            "contract_control",
            "sellability",
            "liquidity",
            "holder_concentration"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
